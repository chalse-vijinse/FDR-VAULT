# SecureFDR Environment Configuration
# SIH26265 - Security Deposit / FDR Management Portal

NODE_ENV=development
PORT=5000

# Database Configuration
# Supported drivers: 'sqlite' (portable built-in zero-config), 'mysql', or 'postgres'/'supabase'
DB_CLIENT=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=securefdr_db

# Supabase Configuration (Optional - provides cloud PostgreSQL, Auth, and Storage)
# Set your Supabase project credentials below when connecting to Supabase:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=fdr-documents

# Authentication Security
JWT_SECRET=securefdr_super_secret_jwt_key_sih26265_demo_2026
JWT_EXPIRES_IN=24h

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
